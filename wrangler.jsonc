{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "canteencue-iter",
  "compatibility_date": "2026-10-12",
  "pages_build_output_dir": "dist",
  "observability": {
    "enabled": true
  },
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "dist",
    "not_found_handling": "single-page-application"
  }
}
